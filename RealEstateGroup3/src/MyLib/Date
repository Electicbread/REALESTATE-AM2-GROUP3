package MyLib;

/**
 *
 * @author Synthe
 */
public class Date {
    private int day;
    private String month;
    private int year;

    public Date(int day, String month, int year) {
        this.day = day;
        this.month = month;
        this.year = year;
    }
    
    public void getDate() {
        System.out.println(month + " " + day + ", " + year); //this is just a sample, we'll decide its final output later on
    }
}
